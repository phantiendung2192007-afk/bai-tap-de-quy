#include <iostream>
#include <vector>
#include <bits/stdc++.h>
using namespace std;
using ll = long long;

ll F(int n) {
	if ( n == 0 || n ==1)
		return 1;
	return n*F(n-1);
}
int main () {
	int n ;
	cin >> n;
	if ( n>=0 && n <= 20) {
		cout << "Kết quả : " <<F(n) << endl;}
	else {
		cout << "Khong hop le" << endl;
	}
	return 0;
	}
	
	

	
